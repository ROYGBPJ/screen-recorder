<Application x:Class="NovaScreenRecorder.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF111827"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF74E5FF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9CAFC5"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFF3F8FF"/>
            <Setter Property="Background" Value="#FF202D40"/>
            <Setter Property="BorderBrush" Value="#FF3A506B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFF3F8FF"/>
            <Setter Property="Background" Value="#FF0B1220"/>
            <Setter Property="BorderBrush" Value="#FF33445C"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FF111827"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE8F2FF"/>
            <Setter Property="Margin" Value="4,8"/>
        </Style>
    </Application.Resources>
</Application>
